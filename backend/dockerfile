# syntax=docker/dockerfile:1

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VIRTUAL_ENV=/app/.venv \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

# uv aus dem offiziellen uv-Image übernehmen
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Erst Requirements kopieren, damit Docker den Dependency-Layer cachen kann
COPY requirements.txt ./

# Virtuelle Umgebung erstellen und Dependencies installieren
RUN uv venv "$VIRTUAL_ENV" \
    && uv pip install --no-cache -r requirements.txt

# Danach erst den Anwendungscode kopieren
COPY . .

EXPOSE 8000

CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]

